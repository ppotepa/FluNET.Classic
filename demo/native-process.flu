SAY "Native process execution in FluNET.Classic".

CREATE PROCESS FROM "dotnet" WITH "--version" INTO [dotnetSpec], THEN
RUN [dotnetSpec] INTO [version].

REQUIRE [version] IS OK.
SAY "Installed .NET version:".
SAY [version.StdOut].

CREATE PROCESS FROM "git" WITH "status", "--short" INTO [gitSpec], THEN
RUN [gitSpec] INTO [status].

REQUIRE [status] IS OK.
IF [status.StdOut] IS EMPTY, THEN
    SAY "The working tree is clean.".
ELSE
    SAY "The working tree contains changes.".
    SAY [status.StdOut].
END IF.
